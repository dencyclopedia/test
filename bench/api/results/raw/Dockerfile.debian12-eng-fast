FROM debian:12-slim
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv tesseract-ocr tesseract-ocr-eng && rm -rf /var/lib/apt/lists/* && python3 -m venv /venv && rm -f /usr/share/tesseract-ocr/5/tessdata/eng.traineddata
ADD https://raw.githubusercontent.com/tesseract-ocr/tessdata_fast/87416418657359cb625c412a48b6e1d6d41c29bd/eng.traineddata /usr/share/tesseract-ocr/5/tessdata/eng.traineddata
ENV PATH=/venv/bin:$PATH
ENV OMP_THREAD_LIMIT=1
ENV OCR_LANGS="eng"
WORKDIR /app
COPY requirements.txt .
RUN /venv/bin/pip install --no-cache-dir -r requirements.txt
COPY app.py .
EXPOSE 8000
CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8000"]
