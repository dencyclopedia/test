FROM alpine:3.22
RUN apk add --no-cache python3 tesseract-ocr tesseract-ocr-data-eng tesseract-ocr-data-deu && python3 -m venv /venv
ADD https://raw.githubusercontent.com/tesseract-ocr/tessdata_best/e12c65a915945e4c28e237a9b52bc4a8f39a0cec/eng.traineddata /usr/share/tessdata/eng.traineddata
ADD https://raw.githubusercontent.com/tesseract-ocr/tessdata_best/e12c65a915945e4c28e237a9b52bc4a8f39a0cec/deu.traineddata /usr/share/tessdata/deu.traineddata
ENV PATH=/venv/bin:$PATH
ENV OMP_THREAD_LIMIT=1
ENV OCR_LANGS="eng deu"
WORKDIR /app
COPY requirements.txt .
RUN /venv/bin/pip install --no-cache-dir -r requirements.txt
COPY app.py .
EXPOSE 8000
CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8000"]
