FROM alpine:3.22
RUN apk add --no-cache python3 tesseract-ocr tesseract-ocr-data-eng && python3 -m venv /venv && rm -f /usr/share/tessdata/eng.traineddata
ADD https://raw.githubusercontent.com/tesseract-ocr/tessdata_fast/87416418657359cb625c412a48b6e1d6d41c29bd/eng.traineddata /usr/share/tessdata/eng.traineddata
ENV PATH=/venv/bin:$PATH
ENV OMP_THREAD_LIMIT=1
ENV OCR_LANGS="eng"
WORKDIR /app
COPY requirements.txt .
RUN /venv/bin/pip install --no-cache-dir -r requirements.txt
COPY app.py .
EXPOSE 8000
CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8000"]
